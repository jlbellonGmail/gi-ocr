# Entorno / control de versiones / historial del circuito agentico
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
.git/
.gitignore
runs/

# Datos runtime reales (no versionar comprobantes ni jobs de clientes en
# la imagen; docker-compose.yml los provee via volumen en runtime)
storage_bridge/inbound/*
storage_bridge/ready/*
storage_bridge/failed/*
!storage_bridge/inbound/.gitkeep
!storage_bridge/ready/.gitkeep
!storage_bridge/failed/.gitkeep
!storage_bridge/README.md
output/
/inbound/

# Datos privados / evidencia local, nunca en el contexto de build
_local_samples/
_ocr_reports/
e2e_evidence/
.playwright/
_bench/

# Sitio MkDocs generado
site/

# Tests (no necesarios en la imagen de runtime)
tests/
backend/tests/

# Artefactos de otros editores / IDEs
.claude/settings.local.json
.cursor/
.vscode/
.idea/

# Docker
Dockerfile
.dockerignore
docker-compose.yml
